# GEO PULSE deployment example. Copy to /opt/geopulse/.env and replace secrets.
DB_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://thermo:replace-with-a-long-random-password@db:5432/cis_thermometer
REDIS_URL=redis://redis:6379/0

# Collection and analysis providers. Public investigation GETs never call them.
OPENROUTER_API_KEY=
JINA_API_KEY=
OPENAI_API_KEY=
LLM_MODELS=
OLLAMA_URL=

# Public API/web configuration.
ADMIN_API_KEY=replace-with-a-separate-long-random-secret
CORS_ORIGINS=https://massaraksh.tech
NEXT_PUBLIC_API_URL=

# Server-only frontend flags. Search/stories are wired in Task 8; investigation
# and signal detail require Task 9. Changing one requires `docker compose build
# web` followed by `docker compose up -d web`. Missing/malformed values default off.
FEATURE_SEARCH_NAVIGATION=false
FEATURE_STORIES_NAVIGATION=false
FEATURE_INVESTIGATION=false
FEATURE_SIGNAL_DETAIL=false

# Optional collectors/loaders.
COMTRADE_API_KEY=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=geopulse_vox
