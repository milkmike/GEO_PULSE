# ── GEO PULSE — конфигурация окружения ──
# Скопируйте в .env и заполните. Минимум для мирового контура: DB_PASSWORD +
# OPENROUTER_API_KEY (+ JINA_API_KEY для кластеризации сюжетов).

# === БАЗА ДАННЫХ (обязательно) ===
# Любой надёжный пароль. DATABASE_URL ДОЛЖЕН содержать тот же пароль.
DB_PASSWORD=change-me-strong-password
DATABASE_URL=postgresql://thermo:change-me-strong-password@db:5432/cis_thermometer

# === LLM (обязательно для анализа и брифингов) ===
# Ключ OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Необязательно: своя цепочка моделей (через запятую, первая — основная).
# По умолчанию (src/llm.py): deepseek/deepseek-v4-flash → xiaomi/mimo-v2.5 →
# google/gemini-2.0-flash-001 (DeepSeek V4 Flash ~10x дешевле Gemini 3 Flash).
LLM_MODELS=

# «Тяжёлая» модель для пакетных строгих-JSON задач (дедуп/кластеризация тредов,
# reanalyze, дайджесты). Qwen — лучшая structured-output дисциплина среди дешёвых.
# Альтернативы: deepseek/deepseek-v4-flash, xiaomi/mimo-v2.5-pro.
HEAVY_MODEL=qwen/qwen3.6-flash

# Модель для брифингов (русская проза) — отдельно от анализатора. Qwen сильнее
# всего в русском. Альтернативы: qwen/qwen3.5-plus-20260420, deepseek/deepseek-v4-flash.
BRIEFS_MODEL=qwen/qwen3.7-plus

# Необязательно: локальная Ollama как последний фолбэк (без ключей).
# Пример: http://172.17.0.1:11434
OLLAMA_URL=

# === Безопасность / прод-настройки (серверные, держать только в .env) ===
# Ключ для admin-эндпоинтов и методов записи. ПУСТО = admin/запись закрыты
# для всех (безопасно по умолчанию для публичного API). Задайте, если нужен
# доступ к /api/v1/admin/* — тогда шлите заголовок X-Admin-Key: <значение>.
ADMIN_API_KEY=

# CORS: список origin через запятую, или * для всех. Для прод-домена сузьте.
CORS_ORIGINS=*

# Пейсинг запросов к GDELT (сек). 5 по умолчанию; на «шумных» IP поднимите
# до 30–45, если ловите 429 Too Many Requests.
GDELT_PAUSE_SEC=5

# Авто-карантин источников: снять active после N подряд неудачных fetch.
# 0 (по умолчанию) = не отключать, только записывать причину (last_status/
# last_error/consecutive_failures видны в /api/v2/health/sources).
SOURCE_QUARANTINE_AFTER=0

# === EMBEDDINGS (нужно для threads/кластеризации сюжетов) ===
JINA_API_KEY=

# === Необязательные интеграции ===
OPENAI_API_KEY=
COMTRADE_API_KEY=

# === TELEGRAM (только если поднимаете vox-/tg-коллекторы) ===
# Оставьте пустым — telegram-сервисы не запустятся, мировой контур работает без них.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=geopulse_vox
# MTProto proxy for tg-collector only. Supports socks5://, socks4://, http://.
TELEGRAM_PROXY_URL=
VOX_MODEL=deepseek/deepseek-v4-flash

# Optional Jev story-pair evaluation. off makes no paid calls; shadow only logs
# decisions and never changes clustering. Enable after a separately approved
# evaluation budget. One request per incremental cycle, up to 20 pairs.
JEV_STORY_MODE=off
JEV_STORY_TIMEOUT_SECONDS=2

# Early local-change screening, hourly. Same persistent $2 campaign across restarts.
# 0 disables paid calls; writer drafts require explicit context and editorial release.
EARLY_SIGNAL_BUDGET_USD=0

# Shared screening / article relations / evidence review model. Fixed models:
# openrouter = DeepSeek V4 Flash via the existing gateway (default)
# deepseek = DeepSeek Flash via api.deepseek.com, its own key required
# gemini = Gemini 3.1 Flash-Lite via Google, its own key required
# jev = legacy native Decisions API for an explicitly selected comparison
# Explicit selection only; no retry or automatic paid provider fallback.
# Public API must use the SAME selection as the workers for model/version caches.
DECISION_PROVIDER=openrouter
# Independent evidence stage for decision cards. apply keeps the drafting and
# discovery models above, but Jev selects and reviews exact source fragments.
# Up to two attempts per annotation; shared persistent campaign cap, no retries.
# off retains the existing review. Source proof already saved remains readable.
JEV_EVIDENCE_MODE=off
# Decision workers also accept the existing service-scoped gateway setting.
# An explicitly set HTTPS_PROXY takes precedence; keep gateway credentials private.
OPENROUTER_HTTPS_PROXY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
# Existing persistent account is retained by default. Use a new named account
# only within an explicitly approved total budget; never reset the old ledger.
# Public API and agendas worker share this name; early signals keep their own cap.
DECISION_CAMPAIGN=jev-agenda-2026-09-30
